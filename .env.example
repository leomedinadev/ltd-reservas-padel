# Variables del backend (todas opcionales en desarrollo)

# Obligatoria en producción: secreto para firmar las sesiones (JWT)
JWT_SECRET=

# Puerto del backend
PORT=3001

# Ruta del archivo SQLite (por defecto db/padel.db)
DB_PATH=

# Zona horaria del club: define qué es "hoy" y qué bloques ya pasaron
TZ=America/Guayaquil
